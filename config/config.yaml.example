llm:
  provider: caii
  caii:
    # Cloudera AI Inference endpoint (the /v1 suffix is added automatically if missing).
    # The model must support OpenAI-style tool calling — verify with a test request
    # before pointing the app at a new endpoint.
    endpoint: https://<workspace-domain>/namespaces/serving-default/endpoints/<endpoint-name>/v1
    model: <model-id>
    # Leave blank. Inside a CML session the JWT is read from /tmp/jwt automatically;
    # otherwise set the CDP_TOKEN environment variable. Never commit a real token.
    api_key: ""
  vllm:
    # Any vLLM server exposing the OpenAI-compatible API (the /v1 suffix is
    # added automatically if missing). The model must match the server's
    # --served-model-name and support OpenAI-style tool calling
    # (start vLLM with --enable-auto-tool-choice and a matching --tool-call-parser).
    endpoint: http://localhost:8000/v1
    model: meta-llama/Llama-3.1-8B-Instruct
    # Only needed if the server was started with --api-key.
    api_key: ""
  ollama:
    endpoint: http://localhost:8000/api/v1
    model: meta-llama/Llama-3.1-8B-Instruct
    api_key: ollama
  guard:
    # Llama Guard screens each question before the agent runs and each answer
    # before it reaches the UI. Off by default: it needs a guard model served
    # somewhere. If the guard is unreachable the turn proceeds unscreened.
    enabled: false
    model: meta-llama/Llama-Guard-3-8B
    # Leave blank to reuse the chat provider's endpoint and credentials above.
    endpoint: ""
    api_key: ""
    timeout_seconds: 10
  temperature: 0.1
  max_tokens: 2048
data:
  n_users: 2000
  n_merchants: 500
  n_transactions: 200000
  fraud_rate: 0.03
  raw_dir: data/raw
  processed_dir: data/processed
  db_path: data/transactions.db
training:
  max_depth: 6
  learning_rate: 0.2
  n_estimators: 512
  scale_pos_weight: auto
  test_size: 0.2
  val_size: 0.1
gpu:
  enabled: auto
on_prem:
  enabled: true
  gpu_preset: h100_pcie
  num_gpus: 1
  server_power_watts: 300.0
  pue: 1.3
  electricity_rate_kwh: 0.15
  gpu_utilization_pct: 75.0
  amortization_years: 3.0
  maintenance_pct: 10.0
  server_base_cost_usd: 5000.0
  tokens_per_second: null
