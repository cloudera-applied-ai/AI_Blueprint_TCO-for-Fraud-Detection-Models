# Copy to .env in the repo root to override config/config.yaml per deployment.
# docker-compose.yml loads it if present; never commit the real file.

# LLM Provider: "caii", "vllm", or "ollama"
LLM_PROVIDER=caii

# Cloudera AI Inferencing Service
CAII_ENDPOINT=https://your-caii-endpoint.cloudera.site
CDP_TOKEN=your-cdp-token

# vLLM OpenAI-compatible server (API key only if started with --api-key)
# VLLM_ENDPOINT=http://localhost:8000/v1
# VLLM_API_KEY=

# Ollama
# OLLAMA_ENDPOINT=http://localhost:11434/v1

# Llama Guard safeguards — screens each question before the agent runs and each
# answer before it is shown. Blank GUARD_ENDPOINT reuses the provider above.
# GUARD_ENABLED=1
# GUARD_MODEL=meta-llama/Llama-Guard-3-8B
# GUARD_ENDPOINT=
# GUARD_API_KEY=

# Optional: comma-separated origins allowed to call the API cross-origin.
# Leave unset for same-origin only (the default, and correct for normal use).
# ALLOWED_ORIGINS=

# Skip the container's first-run data generation + model training (Docker only)
# FRAUD_DETECTION_SKIP_BOOTSTRAP=1

# Force CPU even when an NVIDIA GPU + RAPIDS are present
# FRAUD_DETECTION_FORCE_CPU=1
