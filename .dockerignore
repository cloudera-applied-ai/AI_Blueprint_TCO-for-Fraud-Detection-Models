# Git / CI
.git
.gitignore

# Python caches & envs
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Frontend deps & build (deps reinstalled, dist rebuilt in the image)
app/frontend/node_modules/
app/frontend/dist/

# Bind-mounted at runtime — keep them out of the image
data/
models/

# Holds credentials — bind-mount config/ at runtime instead of baking it in
config/config.yaml

# Heavy artifacts the app doesn't need
*.pptx
docs/
ai/notebooks/
tests/
governance/
.cicd/

# OS / editor
.DS_Store
*.log
.claude/
